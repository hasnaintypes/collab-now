{
  "name": "@collabnow/db",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "dotenv -e ../../apps/web/.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../apps/web/.env -- drizzle-kit migrate",
    "db:push": "dotenv -e ../../apps/web/.env -- drizzle-kit push",
    "db:studio": "dotenv -e ../../apps/web/.env -- drizzle-kit studio",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^5.1.7"
  },
  "devDependencies": {
    "@collabnow/typescript-config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5"
  }
}
