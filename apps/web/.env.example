DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
BETTER_AUTH_SECRET=""       # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# Liveblocks
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=""
LIVEBLOCKS_SECRET_KEY=""

# UploadThing (avatar uploads)
UPLOADTHING_TOKEN=""

# Gmail SMTP (for workspace invites)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Gemini API (AI notes generation, P1-6, and chunk embeddings, P2-3 — see
# apps/web/src/lib/gemini/index.ts, apps/web/src/features/ingestion/lib/notes-generator.ts,
# and apps/web/src/features/ingestion/lib/chunk-embedder.ts)
GEMINI_API_KEY=""

# Inngest (async job queue, P0-16 — see apps/web/src/lib/inngest/). For local
# dev, run `npx inngest-cli@latest dev` in a separate terminal AND set
# INNGEST_DEV=1 below — without it the SDK defaults to "cloud mode" and
# every `inngest.send()` fails immediately with "no signing key found",
# even though nothing here needs a real key until this app is registered
# against the hosted Inngest dashboard for a real deployed environment.
INNGEST_DEV=1
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Paddle (billing, P3-1/P3-2 — see docs/PRD.md §6.12). PADDLE_API_KEY stays
# server-only — features/billing/lib/paddle-api.ts uses it to create a
# checkout transaction after re-verifying the caller's workspace role, so a
# client can never forge which workspace a checkout gets attributed to.
# PADDLE_WEBHOOK_SECRET also stays server-only, for P3-3's webhook signature
# verification. The client token and price IDs aren't secrets — Paddle.js
# needs them in the browser to load and open its checkout overlay
# (features/billing/lib/load-paddle.ts), so they're NEXT_PUBLIC_.
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
NEXT_PUBLIC_PADDLE_ENV="sandbox"          # "sandbox" | "production"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO=""
NEXT_PUBLIC_PADDLE_PRICE_ID_TEAM=""

# Playwright E2E smoke test (optional — defaults to e2e@collabnow.test if unset)
E2E_USER_EMAIL=""
E2E_USER_PASSWORD=""
E2E_BASE_URL=""
