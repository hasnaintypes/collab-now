# Base URL of the CollabNow web app this extension talks to (see
# src/lib/config.ts). Defaults to local dev if unset — override when
# building against a deployed instance (e.g. for a Chrome Web Store
# release build: VITE_API_BASE_URL="https://collabnow.built-on.dev").
VITE_API_BASE_URL="http://localhost:3000"
